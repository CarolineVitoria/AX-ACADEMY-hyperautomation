<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                    id="Definitions_TOBE"
                    targetNamespace="http://ax-academy.local/portal-fake/tobe">

  <bpmn2:process id="Processo_TOBE" name="Cadastro de Clientes - Portal Fake (TO-BE / Automatizado)" isExecutable="false">

    <bpmn2:laneSet id="LaneSet_TOBE">
      <bpmn2:lane id="Lane_Cliente" name="Cliente">
        <bpmn2:flowNodeRef>StartEvent_Cliente</bpmn2:flowNodeRef>
      </bpmn2:lane>
      <bpmn2:lane id="Lane_Robo" name="Robô (RPA - Python + Playwright)">
        <bpmn2:flowNodeRef>Task_AcessarCaixa</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_BaixarAnexos</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_ValidarDocs</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Gateway_Aprovado</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_MoverOk</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RegistrarPlanilha</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_ResponderAprovado</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Aprovado</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_MoverPendente</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_ResponderPendente</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_Pendente</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>BoundaryEvent_ErroCaixa</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>Task_RegistrarErroLog</bpmn2:flowNodeRef>
        <bpmn2:flowNodeRef>EndEvent_ErroInterrompido</bpmn2:flowNodeRef>
      </bpmn2:lane>
    </bpmn2:laneSet>

    <bpmn2:startEvent id="StartEvent_Cliente" name="Cliente envia e-mail com solicitação de cadastro">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:task id="Task_AcessarCaixa" name="Acessar caixa de e-mail e identificar novas solicitações (RN01)">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:boundaryEvent id="BoundaryEvent_ErroCaixa" name="Caixa de e-mail indisponível" attachedToRef="Task_AcessarCaixa">
      <bpmn2:errorEventDefinition/>
      <bpmn2:outgoing>Flow_Erro1</bpmn2:outgoing>
    </bpmn2:boundaryEvent>

    <bpmn2:task id="Task_RegistrarErroLog" name="Registrar erro em log">
      <bpmn2:incoming>Flow_Erro1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Erro2</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:endEvent id="EndEvent_ErroInterrompido" name="Execução interrompida (reprocessar na próxima execução agendada)">
      <bpmn2:incoming>Flow_Erro2</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:task id="Task_BaixarAnexos" name="Baixar documentos anexados (RN02)">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_ValidarDocs" name="Validar nome, CPF, nascimento e endereço (RN03/RN04)">
      <bpmn2:incoming>Flow_3</bpmn2:incoming>
      <bpmn2:outgoing>Flow_4</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:exclusiveGateway id="Gateway_Aprovado" name="Cadastro aprovado?">
      <bpmn2:incoming>Flow_4</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Sim</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Nao</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:task id="Task_MoverOk" name="Mover arquivos para Documentos_OK/ (RN05)">
      <bpmn2:incoming>Flow_Sim</bpmn2:incoming>
      <bpmn2:outgoing>Flow_5</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_RegistrarPlanilha" name="Registrar dados na Planilha Mestra (RN07)">
      <bpmn2:incoming>Flow_5</bpmn2:incoming>
      <bpmn2:outgoing>Flow_6</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_ResponderAprovado" name="Enviar e-mail confirmando aprovação (RN08)">
      <bpmn2:incoming>Flow_6</bpmn2:incoming>
      <bpmn2:outgoing>Flow_7</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:endEvent id="EndEvent_Aprovado" name="Cadastro aprovado e cliente notificado">
      <bpmn2:incoming>Flow_7</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:task id="Task_MoverPendente" name="Mover arquivos para Documentos_Pendentes/ (RN06)">
      <bpmn2:incoming>Flow_Nao</bpmn2:incoming>
      <bpmn2:outgoing>Flow_8</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:task id="Task_ResponderPendente" name="Enviar e-mail informando motivo da pendência (RN08)">
      <bpmn2:incoming>Flow_8</bpmn2:incoming>
      <bpmn2:outgoing>Flow_9</bpmn2:outgoing>
    </bpmn2:task>

    <bpmn2:endEvent id="EndEvent_Pendente" name="Cadastro pendente e cliente notificado">
      <bpmn2:incoming>Flow_9</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="Flow_1" sourceRef="StartEvent_Cliente" targetRef="Task_AcessarCaixa"/>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Task_AcessarCaixa" targetRef="Task_BaixarAnexos"/>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Task_BaixarAnexos" targetRef="Task_ValidarDocs"/>
    <bpmn2:sequenceFlow id="Flow_4" sourceRef="Task_ValidarDocs" targetRef="Gateway_Aprovado"/>
    <bpmn2:sequenceFlow id="Flow_Sim" name="Sim" sourceRef="Gateway_Aprovado" targetRef="Task_MoverOk"/>
    <bpmn2:sequenceFlow id="Flow_Nao" name="Não" sourceRef="Gateway_Aprovado" targetRef="Task_MoverPendente"/>
    <bpmn2:sequenceFlow id="Flow_5" sourceRef="Task_MoverOk" targetRef="Task_RegistrarPlanilha"/>
    <bpmn2:sequenceFlow id="Flow_6" sourceRef="Task_RegistrarPlanilha" targetRef="Task_ResponderAprovado"/>
    <bpmn2:sequenceFlow id="Flow_7" sourceRef="Task_ResponderAprovado" targetRef="EndEvent_Aprovado"/>
    <bpmn2:sequenceFlow id="Flow_8" sourceRef="Task_MoverPendente" targetRef="Task_ResponderPendente"/>
    <bpmn2:sequenceFlow id="Flow_9" sourceRef="Task_ResponderPendente" targetRef="EndEvent_Pendente"/>
    <bpmn2:sequenceFlow id="Flow_Erro1" sourceRef="BoundaryEvent_ErroCaixa" targetRef="Task_RegistrarErroLog"/>
    <bpmn2:sequenceFlow id="Flow_Erro2" sourceRef="Task_RegistrarErroLog" targetRef="EndEvent_ErroInterrompido"/>

  </bpmn2:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Processo_TOBE">

      <bpmndi:BPMNShape id="Lane_Cliente_di" bpmnElement="Lane_Cliente" isHorizontal="true">
        <dc:Bounds x="90" y="40" width="1560" height="120"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Robo_di" bpmnElement="Lane_Robo" isHorizontal="true">
        <dc:Bounds x="90" y="160" width="1560" height="420"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_Cliente_di" bpmnElement="StartEvent_Cliente">
        <dc:Bounds x="130" y="82" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="100" y="118" width="96" height="53"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_AcessarCaixa_di" bpmnElement="Task_AcessarCaixa">
        <dc:Bounds x="220" y="200" width="130" height="90"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="BoundaryEvent_ErroCaixa_di" bpmnElement="BoundaryEvent_ErroCaixa">
        <dc:Bounds x="267" y="272" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="245" y="312" width="82" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RegistrarErroLog_di" bpmnElement="Task_RegistrarErroLog">
        <dc:Bounds x="220" y="440" width="130" height="80"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_ErroInterrompido_di" bpmnElement="EndEvent_ErroInterrompido">
        <dc:Bounds x="272" y="550" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="200" y="588" width="180" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_BaixarAnexos_di" bpmnElement="Task_BaixarAnexos">
        <dc:Bounds x="410" y="200" width="130" height="90"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ValidarDocs_di" bpmnElement="Task_ValidarDocs">
        <dc:Bounds x="600" y="200" width="130" height="90"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Gateway_Aprovado_di" bpmnElement="Gateway_Aprovado" isMarkerVisible="true">
        <dc:Bounds x="780" y="220" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="757" y="273" width="96" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MoverOk_di" bpmnElement="Task_MoverOk">
        <dc:Bounds x="890" y="100" width="140" height="90"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_RegistrarPlanilha_di" bpmnElement="Task_RegistrarPlanilha">
        <dc:Bounds x="1080" y="100" width="140" height="90"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ResponderAprovado_di" bpmnElement="Task_ResponderAprovado">
        <dc:Bounds x="1270" y="100" width="140" height="90"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Aprovado_di" bpmnElement="EndEvent_Aprovado">
        <dc:Bounds x="1462" y="127" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1440" y="167" width="80" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_MoverPendente_di" bpmnElement="Task_MoverPendente">
        <dc:Bounds x="890" y="330" width="140" height="90"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ResponderPendente_di" bpmnElement="Task_ResponderPendente">
        <dc:Bounds x="1080" y="330" width="140" height="90"/>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_Pendente_di" bpmnElement="EndEvent_Pendente">
        <dc:Bounds x="1272" y="357" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="1250" y="397" width="80" height="40"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="148" y="118"/><di:waypoint x="148" y="245"/><di:waypoint x="220" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="350" y="245"/><di:waypoint x="410" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="540" y="245"/><di:waypoint x="600" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="730" y="245"/><di:waypoint x="780" y="245"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sim_di" bpmnElement="Flow_Sim">
        <di:waypoint x="805" y="220"/><di:waypoint x="805" y="145"/><di:waypoint x="890" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Nao_di" bpmnElement="Flow_Nao">
        <di:waypoint x="805" y="270"/><di:waypoint x="805" y="375"/><di:waypoint x="890" y="375"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="1030" y="145"/><di:waypoint x="1080" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="1220" y="145"/><di:waypoint x="1270" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_7_di" bpmnElement="Flow_7">
        <di:waypoint x="1410" y="145"/><di:waypoint x="1462" y="145"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_8_di" bpmnElement="Flow_8">
        <di:waypoint x="1030" y="375"/><di:waypoint x="1080" y="375"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_9_di" bpmnElement="Flow_9">
        <di:waypoint x="1220" y="375"/><di:waypoint x="1272" y="375"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Erro1_di" bpmnElement="Flow_Erro1">
        <di:waypoint x="285" y="308"/><di:waypoint x="285" y="440"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Erro2_di" bpmnElement="Flow_Erro2">
        <di:waypoint x="285" y="520"/><di:waypoint x="285" y="550"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn2:definitions>
