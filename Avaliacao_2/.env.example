# Configurações da automação de cadastro - Portal Fake.
# Copie este arquivo para ".env" e ajuste conforme necessário.
# NUNCA versione o arquivo ".env" (já está listado no .gitignore).

# Provedor do webmail acessado via Playwright: gmail | outlook
EMAIL_PROVEDOR=gmail

# Executar o navegador em modo headless (true/false).
# Use "false" durante o desenvolvimento para acompanhar a automação na tela.
PLAYWRIGHT_HEADLESS=false

# NÃO há login/senha configurados aqui: a autenticação é feita manualmente
# UMA VEZ com "python src/arquivos_auxiliares/login_manual.py", que salva a
# sessão em src/arquivos_auxiliares/auth_state.json (também não deve ser
# versionado). Isso evita que o login automatizado seja bloqueado pelo
# provedor com o aviso "Este navegador ou app pode não ser seguro".
